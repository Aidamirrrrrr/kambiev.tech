# --- Контактная форма -------------------------------------------------------
# Заявки с формы на сайте уходят в Telegram через бота.
# Токен: @BotFather → /newbot. Chat ID: напишите боту и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates — id лежит в result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Бот «Kambiev Mail» -----------------------------------------------------
# Пересылает входящую почту с hello@kambiev.tech и принимает новое резюме.
MAIL_BOT_TOKEN=
# Ваш личный chat id — только он вправе подменять резюме на сайте.
MAIL_BOT_CHAT_ID=
# Произвольная случайная строка. Её же передаёте в setWebhook как secret_token,
# Telegram будет слать её в заголовке x-telegram-bot-api-secret-token.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Resend (входящая почта) ------------------------------------------------
# API-ключ: https://resend.com/api-keys — нужен для чтения тела письма.
RESEND_API_KEY=
# Signing secret вебхука из https://resend.com/webhooks (начинается с whsec_).
RESEND_WEBHOOK_SECRET=

# --- Резюме -----------------------------------------------------------------
# Путь к PDF, который отдаёт /resume.pdf. На проде указывает внутрь тома,
# чтобы бот мог подменить файл без пересборки образа.
RESUME_PATH=/app/data/resume.pdf
