# --- Контактная форма -------------------------------------------------------
# Заявки с формы уходят в Telegram через бота.
# Токен: @BotFather → /newbot. Chat ID: напишите боту и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates — id лежит в result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Входящая почта ---------------------------------------------------------
# Письма на hello@kambiev.tech пересылаются в Telegram отдельным ботом.
MAIL_BOT_TOKEN=
MAIL_BOT_CHAT_ID=

# Ключ нужен, чтобы прочитать тело письма: https://resend.com/api-keys
RESEND_API_KEY=
# Signing secret вебхука из https://resend.com/webhooks (начинается с whsec_).
RESEND_WEBHOOK_SECRET=

# --- Алерты -----------------------------------------------------------------
# Куда сообщать о сбоях на сервере. Если не заданы, используются MAIL_BOT_*.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
